# Copy this file to .env and fill in your values
# Never commit the actual .env file to git

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Get a free cluster at: https://cloud.mongodb.com
MONGO_URI=mongodb://localhost:27017/equityedge

# JWT
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URLs (for CORS whitelist)
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Paper trading defaults
INITIAL_CASH_BALANCE=1000000
